<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#100a07">
    <meta name="description" content="Bear Visuals — визуальный мод для Minecraft.">
    <title>Bear Visuals — Visuals. Your Style.</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #100a07;
            --bg-light: #160d09;
            --panel: #1c110c;
            --panel-light: #24160f;
            --brown: #8b5a2b;
            --accent: #b8793e;
            --gold: #d29a61;
            --text: #fff4e8;
            --muted: #b8a99d;
            --soft: #77685d;
            --border: rgba(210, 154, 97, 0.18);
            --green: #9ed7aa;
            --red: #ff9288;
            --radius: 16px;
            --max-width: 1160px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background:
                radial-gradient(
                    ellipse at 50% 0%,
                    rgba(139, 90, 43, 0.16),
                    transparent 42%
                ),
                var(--bg);
            color: var(--text);
            font-family: Manrope, "Segoe UI", Arial, sans-serif;
            line-height: 1.55;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        button:disabled {
            opacity: 0.55;
            cursor: wait;
        }

        .wrap {
            width: min(var(--max-width), calc(100% - 40px));
            margin: auto;
        }

        /* HEADER */

        .nav {
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
            border-bottom: 1px solid rgba(210, 154, 97, 0.09);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            font-weight: 800;
            font-size: 17px;
            letter-spacing: -0.4px;
        }

        .brand-mark {
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            border: 1px solid rgba(210, 154, 97, 0.42);
            background: linear-gradient(145deg, #57351f, #24160f);
            box-shadow: 0 0 24px rgba(184, 121, 62, 0.12);
            color: var(--gold);
            font-size: 22px;
        }

        .brand small {
            display: block;
            color: var(--soft);
            font-size: 9px;
            letter-spacing: 2px;
            font-weight: 700;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
            color: #c1b0a3;
            font-size: 12px;
            font-weight: 700;
        }

        .nav-links a:hover,
        .footer-links a:hover {
            color: var(--gold);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .btn {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            min-height: 43px;
            padding: 0 17px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.025);
            color: var(--text);
            font-size: 12px;
            font-weight: 800;
            transition: transform 0.18s, border-color 0.18s;
        }

        .btn:hover {
            transform: translateY(-1px);
            border-color: rgba(210, 154, 97, 0.5);
        }

        .btn-primary {
            background: linear-gradient(135deg, #b8793e, #8b5a2b);
            border-color: rgba(255, 221, 181, 0.12);
            box-shadow: 0 7px 26px rgba(139, 90, 43, 0.16);
        }

        .btn-primary:hover {
            filter: brightness(1.1);
        }

        /* HERO */

        .hero {
            padding: 82px 0 70px;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            align-items: center;
            gap: 58px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 7px 10px;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: rgba(184, 121, 62, 0.06);
            color: #d5ae87;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.1px;
        }

        .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--gold);
            box-shadow: 0 0 12px rgba(210, 154, 97, 0.65);
        }

        h1 {
            max-width: 690px;
            margin: 24px 0 20px;
            font-size: clamp(42px, 6vw, 70px);
            font-weight: 800;
            line-height: 1.04;
            letter-spacing: -3.5px;
        }

        h1 span {
            color: var(--gold);
        }

        .hero-copy {
            max-width: 570px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.9;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 27px;
        }

        .hero-note {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-top: 25px;
            color: #8d7b6d;
            font-size: 10px;
        }

        .hero-note strong {
            color: #d4c0ae;
        }

        /* CLICK GUI PREVIEW */

        .preview {
            position: relative;
            padding: 13px;
            border: 1px solid rgba(210, 154, 97, 0.2);
            border-radius: 22px;
            background: linear-gradient(
                145deg,
                rgba(44, 27, 18, 0.88),
                rgba(19, 12, 9, 0.96)
            );
            box-shadow: 0 32px 100px rgba(0, 0, 0, 0.35);
            transform: rotate(1deg);
        }

        .preview-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 10px 15px;
            color: #a38b78;
            font-size: 10px;
        }

        .window-dots {
            display: flex;
            gap: 5px;
        }

        .window-dots i {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #765239;
        }

        .preview-panel {
            padding: 19px;
            border: 1px solid rgba(210, 154, 97, 0.12);
            border-radius: 14px;
            background: rgba(12, 8, 6, 0.48);
        }

        .preview-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 17px;
        }

        .preview-heading b {
            font-size: 15px;
        }

        .preview-heading small {
            color: var(--soft);
            font-size: 10px;
        }

        .module-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px;
            margin-top: 8px;
            border: 1px solid rgba(210, 154, 97, 0.11);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.018);
        }

        .module-left {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .module-icon {
            width: 31px;
            height: 31px;
            display: grid;
            place-items: center;
            border-radius: 8px;
            background: rgba(184, 121, 62, 0.12);
            color: var(--gold);
        }

        .module-row b {
            display: block;
            font-size: 11px;
        }

        .module-row small {
            display: block;
            margin-top: 2px;
            color: var(--soft);
            font-size: 9px;
        }

        .switch {
            width: 29px;
            height: 16px;
            padding: 3px;
            border-radius: 20px;
            background: #493222;
        }

        .switch::after {
            content: "";
            display: block;
            width: 10px;
            height: 10px;
            margin-left: 13px;
            border-radius: 50%;
            background: var(--gold);
        }

        .preview-footer {
            display: flex;
            gap: 8px;
            margin-top: 13px;
        }

        .preview-stat {
            flex: 1;
            padding: 12px;
            border: 1px solid rgba(210, 154, 97, 0.1);
            border-radius: 9px;
            background: rgba(184, 121, 62, 0.055);
        }

        .preview-stat small {
            display: block;
            color: var(--soft);
            font-size: 9px;
        }

        .preview-stat b {
            font-size: 14px;
            color: #ead5c1;
        }

        .float-tag {
            position: absolute;
            right: -12px;
            bottom: 35px;
            padding: 12px 15px;
            border: 1px solid rgba(210, 154, 97, 0.25);
            border-radius: 12px;
            background: #21140e;
            box-shadow: 0 12px 35px #0005;
            color: #c7ad97;
            font-size: 10px;
        }

        .float-tag strong {
            color: var(--gold);
        }

        /* ANNOUNCEMENT */

        .announcement {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 17px 20px;
            margin: 6px 0 70px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: linear-gradient(
                100deg,
                rgba(139, 90, 43, 0.11),
                rgba(28, 17, 12, 0.75)
            );
        }

        .announce-icon {
            width: 35px;
            height: 35px;
            display: grid;
            flex: 0 0 auto;
            place-items: center;
            border-radius: 10px;
            background: rgba(184, 121, 62, 0.12);
            color: var(--gold);
        }

        .announcement strong {
            display: block;
            font-size: 12px;
        }

        .announcement p {
            margin: 3px 0 0;
            color: var(--muted);
            font-size: 11px;
        }

        .announce-link {
            margin-left: auto;
            color: var(--gold);
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        /* SECTIONS */

        section {
            scroll-margin-top: 35px;
        }

        .section-head {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 25px;
            margin-bottom: 28px;
        }

        .section-kicker {
            color: var(--gold);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .section-head h2 {
            margin: 9px 0 0;
            font-size: clamp(28px, 3.6vw, 42px);
            line-height: 1.12;
            letter-spacing: -1.7px;
        }

        .section-head p {
            max-width: 430px;
            margin: 0;
            color: var(--muted);
            font-size: 12px;
        }

        /* FEATURES */

        .features {
            padding-bottom: 88px;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .feature {
            min-height: 180px;
            padding: 23px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: linear-gradient(
                145deg,
                rgba(36, 22, 15, 0.83),
                rgba(24, 15, 11, 0.76)
            );
            transition: transform 0.2s, border-color 0.2s;
        }

        .feature:hover {
            transform: translateY(-3px);
            border-color: rgba(210, 154, 97, 0.38);
        }

        .feature-icon {
            width: 39px;
            height: 39px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            background: rgba(184, 121, 62, 0.11);
            color: var(--gold);
            font-size: 17px;
        }

        .feature h3 {
            margin: 17px 0 7px;
            font-size: 14px;
        }

        .feature p {
            margin: 0;
            color: var(--muted);
            font-size: 11px;
            line-height: 1.8;
        }

        /* NEWS */

        .news {
            padding-bottom: 90px;
        }

        .news-card {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            gap: 20px;
            padding: 23px 25px;
            border: 1px solid var(--border);
            border-radius: 16px;
            background: rgba(28, 17, 12, 0.62);
        }

        .news-label {
            color: var(--gold);
            font-size: 9px;
            letter-spacing: 1.4px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .news-card h3 {
            margin: 8px 0 5px;
            font-size: 16px;
        }

        .news-card p {
            max-width: 690px;
            margin: 0;
            color: var(--muted);
            font-size: 11px;
        }

        .news-date {
            color: var(--soft);
            font-size: 10px;
            white-space: nowrap;
        }

        /* LICENSE PLANS */

        .pricing {
            padding: 4px 0 95px;
        }

        .pricing .section-head {
            margin-bottom: 35px;
        }

        .plans {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            align-items: stretch;
            gap: 15px;
        }

        .plan {
            position: relative;
            display: flex;
            flex-direction: column;
            min-height: 350px;
            padding: 25px 23px 22px;
            border: 1px solid var(--border);
            border-radius: 17px;
            background: linear-gradient(
                160deg,
                rgba(36, 22, 15, 0.8),
                rgba(23, 14, 10, 0.9)
            );
        }

        .plan.featured {
            border-color: rgba(210, 154, 97, 0.6);
            box-shadow: 0 12px 45px rgba(139, 90, 43, 0.1);
        }

        .popular {
            position: absolute;
            top: -12px;
            right: 18px;
            padding: 5px 10px;
            border-radius: 999px;
            background: var(--accent);
            color: #fff5eb;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .plan-type {
            color: #d7c4b3;
            font-size: 11px;
            font-weight: 800;
        }

        .plan h3 {
            margin: 9px 0;
            font-size: 23px;
            letter-spacing: -0.7px;
        }

        .price {
            display: flex;
            align-items: baseline;
            gap: 7px;
            margin: 8px 0 7px;
        }

        .price strong {
            font-size: 35px;
            letter-spacing: -1.5px;
        }

        .price span {
            color: var(--muted);
            font-size: 11px;
        }

        .plan-desc {
            min-height: 36px;
            margin: 0 0 18px;
            color: var(--muted);
            font-size: 11px;
        }

        .plan ul {
            padding: 17px 0 0;
            margin: 0 0 24px;
            border-top: 1px solid rgba(210, 154, 97, 0.11);
            list-style: none;
        }

        .plan li {
            display: flex;
            align-items: start;
            gap: 8px;
            margin: 10px 0;
            color: #d0bfb0;
            font-size: 10px;
        }

        .check {
            color: var(--gold);
            font-weight: 900;
        }

        .plan .btn {
            width: 100%;
            margin-top: auto;
        }

        .pricing-footnote {
            max-width: 690px;
            margin: 17px auto 0;
            color: var(--soft);
            text-align: center;
            font-size: 10px;
        }

        /* BOTTOM ACCOUNT AREA */

        .account-strip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 24px 26px;
            margin-bottom: 82px;
            border: 1px solid rgba(210, 154, 97, 0.16);
            border-radius: 17px;
            background:
                radial-gradient(
                    ellipse at right,
                    rgba(139, 90, 43, 0.15),
                    transparent 55%
                ),
                #1b100b;
        }

        .account-strip h3 {
            margin: 0 0 5px;
            font-size: 16px;
        }

        .account-strip p {
            margin: 0;
            color: var(--muted);
            font-size: 11px;
        }

        /* FOOTER */

        footer {
            padding: 28px 0 35px;
            border-top: 1px solid rgba(210, 154, 97, 0.1);
            color: var(--soft);
            font-size: 10px;
        }

        .footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .footer-links {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        /* LOGIN / REGISTRATION MODAL */

        .modal-backdrop {
            position: fixed;
            z-index: 20;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(5, 3, 2, 0.78);
            backdrop-filter: blur(8px);
        }

        .modal-backdrop.open {
            display: flex;
        }

        .modal {
            position: relative;
            width: min(100%, 420px);
            padding: 29px;
            border: 1px solid rgba(210, 154, 97, 0.28);
            border-radius: 17px;
            background: linear-gradient(145deg, #24160f, #130c08);
            box-shadow: 0 28px 100px #0009;
        }

        .modal-close {
            position: absolute;
            top: 14px;
            right: 17px;
            width: 31px;
            height: 31px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: transparent;
            color: var(--muted);
            font-size: 18px;
        }

        .modal h2 {
            margin: 4px 0 5px;
            font-size: 24px;
            letter-spacing: -1px;
        }

        .modal-intro {
            margin: 0 0 20px;
            color: var(--muted);
            font-size: 11px;
        }

        .tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px;
            padding: 4px;
            margin-bottom: 20px;
            border: 1px solid rgba(210, 154, 97, 0.13);
            border-radius: 10px;
            background: rgba(0, 0, 0, 0.17);
        }

        .tab {
            padding: 9px;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: var(--muted);
            font-size: 11px;
            font-weight: 800;
        }

        .tab.active {
            background: rgba(184, 121, 62, 0.16);
            color: var(--gold);
        }

        .field {
            display: block;
            margin: 13px 0;
        }

        .field span {
            display: block;
            margin-bottom: 7px;
            color: #ddc8b5;
            font-size: 10px;
            font-weight: 800;
        }

        .field input {
            width: 100%;
            height: 44px;
            padding: 0 12px;
            border: 1px solid var(--border);
            border-radius: 9px;
            outline: none;
            background: var(--bg);
            color: var(--text);
            font-size: 12px;
        }

        .field input:focus {
            border-color: var(--accent);
        }

        .modal .btn {
            width: 100%;
            margin-top: 8px;
        }

        .modal-help {
            margin-top: 14px;
            color: var(--soft);
            font-size: 10px;
            line-height: 1.7;
        }

        .account-state {
            padding: 12px;
            margin-bottom: 12px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: rgba(184, 121, 62, 0.07);
            font-size: 11px;
            overflow-wrap: anywhere;
        }

        .account-state span {
            display: block;
            margin-bottom: 4px;
            color: var(--muted);
            font-size: 10px;
        }

        /* POP-UP NOTIFICATIONS */

        .toast-stack {
            position: fixed;
            z-index: 40;
            top: 18px;
            right: 18px;
            display: grid;
            gap: 9px;
            width: min(360px, calc(100vw - 36px));
        }

        .toast {
            padding: 13px 15px;
            border: 1px solid var(--border);
            border-radius: 11px;
            background: var(--panel-light);
            box-shadow: 0 14px 40px #0006;
            color: var(--text);
            font-size: 11px;
            animation: toastIn 0.2s ease;
        }

        .toast.success {
            border-color: rgba(158, 215, 170, 0.3);
        }

        .toast.error {
            border-color: rgba(255, 146, 136, 0.35);
        }

        .toast small {
            display: block;
            margin-top: 3px;
            color: var(--muted);
            line-height: 1.5;
        }

        @keyframes toastIn {
            from {
                transform: translateY(-5px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* MOBILE */

        @media (max-width: 850px) {
            .nav-links {
                gap: 14px;
            }

            .hero-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .preview {
                width: 100%;
                max-width: 510px;
                margin: 10px auto 0;
            }

            .feature-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .plans {
                grid-template-columns: 1fr;
                max-width: 490px;
                margin: auto;
            }

            .plan {
                min-height: auto;
            }

            .plan-desc {
                min-height: 0;
            }

            .section-head {
                align-items: start;
                flex-direction: column;
            }

            .hero {
                padding: 62px 0;
            }
        }

        @media (max-width: 620px) {
            .wrap {
                width: min(var(--max-width), calc(100% - 28px));
            }

            .nav {
                min-height: 68px;
                gap: 10px;
            }

            .nav-links {
                display: none;
            }

            .brand {
                font-size: 14px;
            }

            .nav-actions .btn {
                min-height: 38px;
                padding: 0 10px;
                font-size: 10px;
            }

            .hero {
                padding: 48px 0;
            }

            h1 {
                font-size: 44px;
                letter-spacing: -2.5px;
            }

            .hero-copy {
                font-size: 13px;
            }

            .hero-buttons .btn {
                flex: 1;
            }

            .announcement {
                align-items: start;
                padding: 14px;
                margin-bottom: 52px;
            }

            .announce-link {
                display: none;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }

            .feature {
                min-height: auto;
            }

            .news-card {
                grid-template-columns: 1fr;
                padding: 19px;
            }

            .news-date {
                white-space: normal;
            }

            .account-strip {
                align-items: start;
                flex-direction: column;
                padding: 20px;
            }

            .footer-inner {
                align-items: start;
                flex-direction: column;
            }

            .modal {
                padding: 24px 20px;
            }

            .float-tag {
                right: 4px;
