<!-- УВЕДОМЛЕНИЯ -->

<div
    class="toast-stack"
    id="toastStack"
    aria-live="polite"
    aria-atomic="false"
></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
    /*
     * НАСТРОЙКИ SUPABASE
     *
     * Используй Publishable key, начинающийся с sb_publishable_.
     * Никогда не вставляй service_role или secret key в сайт.
     */

    const SUPABASE_URL =
        'https://ffhwueictzhtzqexqimm.supabase.co';

    const SUPABASE_PUBLISHABLE_KEY =
        'sb_publishable_uxxzLH--0JEFZaxvUwgkRA_L3qSXxWQ';


    /* ЭЛЕМЕНТЫ */

    const authBackdrop = document.getElementById('authBackdrop');
    const authForm = document.getElementById('authForm');
    const authFormArea = document.getElementById('authFormArea');
    const signedInPanel = document.getElementById('signedInPanel');

    const authTitle = document.getElementById('authTitle');
    const authIntro = document.getElementById('authIntro');

    const loginTab = document.getElementById('loginTab');
    const signupTab = document.getElementById('signupTab');

    const authSubmit = document.getElementById('authSubmit');
    const emailInput = document.getElementById('emailInput');
    const passwordInput = document.getElementById('passwordInput');

    const accountButton = document.getElementById('accountButton');
    const toastStack = document.getElementById('toastStack');


    /* СОСТОЯНИЕ */

    let authMode = 'login';
    let currentSession = null;
    let supabase = null;

    const configured =
        SUPABASE_PUBLISHABLE_KEY.startsWith('sb_publishable_') &&
        !SUPABASE_PUBLISHABLE_KEY.includes('PASTE_');


    if (window.supabase && configured) {
        supabase = window.supabase.createClient(
            SUPABASE_URL,
            SUPABASE_PUBLISHABLE_KEY
        );
    }


    /* УВЕДОМЛЕНИЯ */

    function toast(title, detail = '', type = 'success') {
        const item = document.createElement('div');
        item.className = `toast ${type}`;

        const strong = document.createElement('strong');
        strong.textContent = title;
        item.appendChild(strong);

        if (detail) {
            const small = document.createElement('small');
            small.textContent = detail;
            item.appendChild(small);
        }

        toastStack.appendChild(item);

        window.setTimeout(() => {
            item.remove();
        }, 5200);
    }


    /* ПОНЯТНЫЕ ОШИБКИ */

    function readableError(message) {
        const value = String(message || '').toLowerCase();

        if (value.includes('invalid login credentials')) {
            return 'Неверная почта или пароль.';
        }

        if (value.includes('email not confirmed')) {
            return 'Подтверди почту через письмо от Supabase.';
        }

        if (value.includes('user already registered')) {
            return 'Аккаунт с этой почтой уже существует.';
        }

        if (value.includes('password')) {
            return 'Проверь пароль. Обычно требуется минимум 8 символов.';
        }

        if (value.includes('rate limit')) {
            return 'Слишком много попыток. Попробуй позже.';
        }

        if (value.includes('fetch')) {
            return 'Не удалось подключиться к Supabase. Проверь интернет.';
        }

        return message || 'Неизвестная ошибка. Попробуй ещё раз.';
    }


    /* ОКНО АККАУНТА */

    function openAuth(mode = 'login') {
        authBackdrop.classList.add('open');
        setAuthMode(mode);
        renderAuthState();

        if (!currentSession) {
            window.setTimeout(() => emailInput.focus(), 50);
        }
    }

    function closeAuth() {
        authBackdrop.classList.remove('open');
    }

    function setAuthMode(mode) {
        authMode = mode;

        loginTab.classList.toggle('active', mode === 'login');
        signupTab.classList.toggle('active', mode === 'signup');

        authTitle.textContent =
            mode === 'login'
                ? 'С возвращением'
                : 'Создать аккаунт';

        authIntro.textContent =
            mode === 'login'
                ? 'Войди в аккаунт, чтобы продолжить.'
                : 'Зарегистрируйся с помощью электронной почты.';

        authSubmit.textContent =
            mode === 'login'
                ? 'Войти'
                : 'Создать аккаунт';

        passwordInput.autocomplete =
            mode === 'login'
                ? 'current-password'
                : 'new-password';
    }

    function renderAuthState() {
        const signedIn = Boolean(currentSession?.user);

        signedInPanel.hidden = !signedIn;
        authFormArea.hidden = signedIn;

        accountButton.textContent =
            signedIn
                ? 'Мой аккаунт'
                : 'Войти';

        if (signedIn) {
            document.getElementById('signedInEmail').textContent =
                currentSession.user.email || 'Аккаунт Bear Visuals';

            authTitle.textContent = 'Твой аккаунт';

            authIntro.textContent =
                'Аккаунт подключён. Покупка станет доступна после настройки оплаты.';
        } else {
            setAuthMode(authMode);
        }
    }

    async function refreshSession() {
        if (!supabase) {
            return;
        }

        const { data, error } = await supabase.auth.getSession();

        if (error) {
            console.warn(
                '[Bear Visuals site] getSession:',
                error.message
            );
        }

        currentSession = data?.session || null;
        renderAuthState();
    }


    /* КНОПКИ АККАУНТА */

    document.getElementById('closeAuth').addEventListener(
        'click',
        closeAuth
    );

    authBackdrop.addEventListener('click', (event) => {
        if (event.target === authBackdrop) {
            closeAuth();
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            closeAuth();
        }
    });

    loginTab.addEventListener('click', () => {
        setAuthMode('login');
    });

    signupTab.addEventListener('click', () => {
        setAuthMode('signup');
    });

    accountButton.addEventListener('click', () => {
        openAuth('login');
    });

    document.getElementById('heroAccountButton').addEventListener(
        'click',
        () => openAuth('login')
    );

    document.getElementById('bottomAccountButton').addEventListener(
        'click',
        () => openAuth('login')
    );


    /* РЕГИСТРАЦИЯ И ВХОД */

    authForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!configured || !supabase) {
            toast(
                'Supabase ещё не подключён',
                'Вставь свой sb_publishable_ key в index.html.',
                'error'
            );
            return;
        }

        const email = emailInput.value.trim();
        const password = passwordInput.value;

        if (password.length < 8) {
            toast(
                'Слишком короткий пароль',
                'Используй не менее 8 символов.',
                'error'
            );
            return;
        }

        authSubmit.disabled = true;

        authSubmit.textContent =
            authMode === 'login'
                ? 'Входим…'
                : 'Создаём аккаунт…';

        try {
            let result;

            if (authMode === 'signup') {
                result = await supabase.auth.signUp({
                    email,
                    password,
                    options: {
                        emailRedirectTo:
                            window.location.origin +
                            window.location.pathname
                    }
                });
            } else {
                result = await supabase.auth.signInWithPassword({
                    email,
                    password
                });
            }

            if (result.error) {
                throw result.error;
            }

            currentSession = result.data.session || null;

            if (authMode === 'signup' && !currentSession) {
                toast(
                    'Проверь почту',
                    'Supabase отправил письмо подтверждения, если подтверждение включено.',
                    'success'
                );

                closeAuth();
            } else {
                toast(
                    authMode === 'signup'
                        ? 'Аккаунт создан'
                        : 'Ты вошёл в аккаунт',
                    'Bear Visuals приветствует тебя.',
                    'success'
                );

                closeAuth();
            }

            renderAuthState();

        } catch (error) {
            toast(
                'Не удалось выполнить действие',
                readableError(error.message),
                'error'
            );

        } finally {
            authSubmit.disabled = false;

            authSubmit.textContent =
                authMode === 'login'
                    ? 'Войти'
                    : 'Создать аккаунт';
        }
    });


    /* ВЫХОД */

    document.getElementById('signOutButton').addEventListener(
        'click',
        async () => {
            if (!supabase) {
                return;
            }

            const { error } = await supabase.auth.signOut();

            if (error) {
                toast(
                    'Не удалось выйти',
                    readableError(error.message),
                    'error'
                );
                return;
            }

            currentSession = null;

            renderAuthState();
            closeAuth();

            toast(
                'Ты вышел из аккаунта',
                'До встречи в Bear Visuals.',
                'success'
            );
        }
    );


    /* ПОКУПКА ЛИЦЕНЗИИ */

    document.querySelectorAll('[data-buy]').forEach((button) => {
        button.addEventListener('click', async () => {
            const plan = button.dataset.buy;

            if (!currentSession?.user) {
                toast(
                    'Сначала войди',
                    'Для покупки нужен аккаунт Bear Visuals.',
                    'error'
                );

                openAuth('signup');
                return;
            }

            if (!supabase) {
                toast(
                    'Supabase не подключён',
                    'Добавь Publishable key в конфигурацию сайта.',
                    'error'
                );
                return;
            }

            button.disabled = true;

            const originalText = button.textContent;
            button.textContent = 'Открываем оплату…';

            try {
                /*
                 * Эта функция должна быть создана в Supabase Edge Functions.
                 * Она создаёт платёжную сессию у платёжного провайдера.
                 *
                 * Цену необходимо задавать на сервере, а не принимать
                 * от браузера. Пока функция не настроена, покупка не пройдёт.
                 */

                const { data, error } =
                    await supabase.functions.invoke(
                        'create-checkout',
                        {
                            body: { plan }
                        }
                    );

                if (error) {
                    throw error;
                }

                if (!data?.url || typeof data.url !== 'string') {
                    throw new Error(
                        'Checkout URL не получен. Проверь Edge Function create-checkout.'
                    );
                }

                window.location.assign(data.url);

            } catch (error) {
                console.error(
                    '[Bear Visuals site] Checkout:',
                    error
                );

                toast(
                    'Оплата ещё не настроена',
                    'Нужна серверная функция create-checkout и настройки платёжного провайдера. Ничего не списано.',
                    'error'
                );

            } finally {
                button.disabled = false;
                button.textContent = originalText;
            }
        });
    });


    /* ИНИЦИАЛИЗАЦИЯ SUPABASE */

    if (!configured) {
        console.warn(
            '[Bear Visuals site] Вставь Supabase Publishable key в index.html.'
        );

    } else {
        refreshSession();

        supabase.auth.onAuthStateChange((_event, session) => {
            currentSession = session || null;
            renderAuthState();
        });
    }


    /* УВЕДОМЛЕНИЯ ПОСЛЕ ВОЗВРАТА С ОПЛАТЫ */

    const params = new URLSearchParams(window.location.search);

    if (params.get('payment') === 'success') {
        toast(
            'Возвращение с оплаты',
            'Статус заказа должен быть подтверждён сервером.',
            'success'
        );

    } else if (params.get('payment') === 'cancel') {
        toast(
            'Покупка отменена',
            'Списание не подтверждено. Ты можешь попробовать снова.',
            'error'
        );
    }
</script>

</body>
</html>
